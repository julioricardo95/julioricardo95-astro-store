---
import SearchBox from './islands/SearchBox.jsx';
---

<section class="relative bg-gradient-to-br from-primary-50 via-white to-secondary-50 overflow-hidden">
	<!-- Background Pattern -->
	<div class="absolute inset-0 opacity-5">
		<div class="absolute inset-0 bg-gradient-to-r from-primary-500 to-secondary-500 transform rotate-12 scale-150"></div>
	</div>
	
	<div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
			<!-- Hero Content -->
			<div class="text-center lg:text-left animate-slide-up">
				<h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-6">
					Descubre Productos
					<span class="bg-gradient-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent block">
						Extraordinarios
					</span>
				</h1>
				
				<p class="text-xl text-gray-600 mb-8 max-w-2xl">
					La mejor selección de tecnología, moda y accesorios premium. 
					Calidad garantizada, precios competitivos y envío rápido.
				</p>
				
				<!-- Search Box for Hero -->
				<div class="mb-8">
					<SearchBox client:load />
				</div>
				
				<!-- CTA Buttons -->
				<div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
					<a 
						href="/productos" 
						class="bg-primary-500 hover:bg-primary-600 text-white px-8 py-3 rounded-lg font-semibold transition-all transform hover:scale-105 shadow-lg hover:shadow-xl"
					>
						<i class="fas fa-shopping-bag mr-2"></i>
						Ver Productos
					</a>
					<a 
						href="/articulos" 
						class="bg-white hover:bg-gray-50 text-gray-900 px-8 py-3 rounded-lg font-semibold border-2 border-gray-200 transition-all transform hover:scale-105"
					>
						<i class="fas fa-newspaper mr-2"></i>
						Leer Artículos
					</a>
				</div>
				
				<!-- Features -->
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-12">
					<div class="text-center lg:text-left">
						<div class="inline-flex items-center justify-center w-12 h-12 bg-primary-100 text-primary-600 rounded-xl mb-3">
							<i class="fas fa-shipping-fast text-xl"></i>
						</div>
						<h3 class="font-semibold text-gray-900 mb-1">Envío Rápido</h3>
						<p class="text-sm text-gray-600">Entrega en 24-48h</p>
					</div>
					<div class="text-center lg:text-left">
						<div class="inline-flex items-center justify-center w-12 h-12 bg-secondary-100 text-secondary-600 rounded-xl mb-3">
							<i class="fas fa-shield-alt text-xl"></i>
						</div>
						<h3 class="font-semibold text-gray-900 mb-1">Garantía Total</h3>
						<p class="text-sm text-gray-600">Productos certificados</p>
					</div>
					<div class="text-center lg:text-left">
						<div class="inline-flex items-center justify-center w-12 h-12 bg-accent-100 text-accent-600 rounded-xl mb-3">
							<i class="fas fa-headset text-xl"></i>
						</div>
						<h3 class="font-semibold text-gray-900 mb-1">Soporte 24/7</h3>
						<p class="text-sm text-gray-600">Atención personalizada</p>
					</div>
				</div>
			</div>
			
			<!-- Hero Image -->
			<div class="relative animate-fade-in">
				<div class="relative">
					<img 
						src="https://images.pexels.com/photos/3768894/pexels-photo-3768894.jpeg" 
						alt="Productos Premium" 
						class="rounded-2xl shadow-2xl w-full h-96 object-cover"
						loading="eager"
					/>
					<!-- Floating Cards -->
					<div class="absolute -top-4 -left-4 bg-white rounded-xl shadow-lg p-4 animate-bounce-gentle">
						<div class="flex items-center space-x-2">
							<i class="fas fa-star text-yellow-400"></i>
							<span class="text-sm font-semibold">4.9/5</span>
						</div>
						<p class="text-xs text-gray-600">+10K Reviews</p>
					</div>
					<div class="absolute -bottom-4 -right-4 bg-primary-500 text-white rounded-xl shadow-lg p-4">
						<div class="flex items-center space-x-2">
							<i class="fas fa-percent"></i>
							<span class="text-sm font-semibold">Ofertas</span>
						</div>
						<p class="text-xs">Hasta 50% OFF</p>
					</div>
				</div>
			</div>
		</div>
	</div>
	
	<!-- Scroll Indicator -->
	<div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
		<i class="fas fa-chevron-down text-primary-500 text-2xl"></i>
	</div>
</section>