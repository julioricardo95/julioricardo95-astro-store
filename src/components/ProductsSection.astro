---
import ProductCarousel from './islands/ProductCarousel.jsx';
import productsData from '../data/products.json';

// 1. Normalización defensiva del JSON (Soporta Array directo o encapsulado { products: [...] })
const rawProducts = Array.isArray(productsData) ? productsData : productsData.products || [];

// 2. Filtrar productos destacados (Soporta mayúscula/minúscula)
const filteredByFeatured = rawProducts.filter(product => product.DESTACADO || product.destacado);

// 3. Fallback a los primeros 8 productos si no se han marcado destacados
const featuredProducts = filteredByFeatured.length > 0 
  ? filteredByFeatured 
  : rawProducts.slice(0, 8);
---

<section class="py-10 sm:py-20 bg-white relative overflow-hidden">
    
    <!-- Pattern de Fondo de Puntos Sutil -->
    <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:20px_20px] opacity-40 pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
        
        <!-- ENCABEZADO DE LA SECCIÓN -->
        <div class="text-center mb-8 sm:mb-14">
            
            <!-- Badge superior -->
            <span class="inline-block px-3 py-1 rounded-full bg-primary-50 text-primary-600 border border-primary-100 text-xs font-bold uppercase tracking-wider mb-2.5 sm:mb-3">
                Selección Exclusiva
            </span>

            <!-- Título Principal -->
            <h2 class="text-3xl sm:text-5xl font-black text-gray-900 tracking-tight mb-3 sm:mb-4">
                Productos <span class="bg-gradient-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent">Destacados</span>
            </h2>
            
            <!-- Subtítulo -->
            <p class="text-sm sm:text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
                Descubre nuestra selección curada de productos premium que combinan calidad, innovación y estilo para satisfacer tus necesidades.
            </p>
        </div>

        <!-- ISLA DE REACT: CARRUSEL DE PRODUCTOS -->
        

<ProductCarousel products={featuredProducts} client:load />

        <!-- BOTÓN DE ACCIÓN "VER TODOS" -->
        <div class="text-center mt-8 sm:mt-12">
            <a 
                href="/productos" 
                class="inline-flex items-center justify-center bg-gray-900 hover:bg-primary-600 text-white min-h-[48px] px-6 sm:px-8 py-3.5 rounded-2xl font-bold text-sm sm:text-base transition-all duration-200 active:scale-95 shadow-md hover:shadow-xl group"
            >
                <i class="fas fa-th-large mr-2.5 text-xs sm:text-sm text-gray-400 group-hover:text-white transition-colors"></i>
                <span>Ver Todos los Productos</span>
                <i class="fas fa-arrow-right ml-2.5 text-xs sm:text-sm group-hover:translate-x-1 transition-transform"></i>
            </a>
        </div>

        <!-- REJILLA DE CARACTERÍSTICAS / BENEFICIOS -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-8 mt-12 sm:mt-16 pt-10 sm:pt-16 border-t border-gray-100">
            
            <!-- Calidad -->
            <div class="p-5 sm:p-6 bg-gray-50/80 border border-gray-100/80 rounded-2xl hover:bg-white hover:shadow-md transition-all duration-300">
                <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center mb-3.5 sm:mb-4">
                    <i class="fas fa-medal text-lg sm:text-xl"></i>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-gray-900 mb-1.5">Calidad Premium</h3>
                <p class="text-xs sm:text-sm text-gray-500 leading-relaxed">
                    Productos seleccionados cuidadosamente por nuestros expertos para garantizar la máxima calidad.
                </p>
            </div>

            <!-- Innovación -->
            <div class="p-5 sm:p-6 bg-gray-50/80 border border-gray-100/80 rounded-2xl hover:bg-white hover:shadow-md transition-all duration-300">
                <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-secondary-50 text-secondary-600 flex items-center justify-center mb-3.5 sm:mb-4">
                    <i class="fas fa-rocket text-lg sm:text-xl"></i>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-gray-900 mb-1.5">Innovación Garantizada</h3>
                <p class="text-xs sm:text-sm text-gray-500 leading-relaxed">
                    Las últimas tendencias y tecnologías más avanzadas del mercado en un solo lugar.
                </p>
            </div>

            <!-- Satisfacción -->
            <div class="p-5 sm:p-6 bg-gray-50/80 border border-gray-100/80 rounded-2xl hover:bg-white hover:shadow-md transition-all duration-300">
                <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-3.5 sm:mb-4">
                    <i class="fas fa-heart text-lg sm:text-xl"></i>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-gray-900 mb-1.5">Satisfacción 100%</h3>
                <p class="text-xs sm:text-sm text-gray-500 leading-relaxed">
                    +10,000 clientes satisfechos respaldan la calidad de nuestros productos y servicio postventa.
                </p>
            </div>

        </div>

    </div>
</section>