---
import SearchBox from './islands/SearchBox.jsx';
import { SITE_CONFIG } from '../utils/constants.js';
---

<header class="bg-white/85 backdrop-blur-md border-b border-gray-100/80 shadow-xs sticky top-0 z-40 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16 sm:h-20">
            
            <!-- LOGO CON EFECTO GLOW AL PASAR EL CURSOR -->
            <div class="flex-shrink-0">
                <a href="/" class="flex items-center space-x-3 group">
                    <div class="relative">
                        <div class="absolute -inset-1 bg-gradient-to-r from-primary-600 to-secondary-500 rounded-xl blur-xs opacity-60 group-hover:opacity-100 transition-all duration-300 group-hover:scale-105"></div>
                        <div class="relative w-10 h-10 bg-gradient-to-br from-primary-500 via-primary-600 to-secondary-500 rounded-xl flex items-center justify-center shadow-md">
                            <i class="fas fa-store text-white text-base group-hover:scale-110 transition-transform duration-300"></i>
                        </div>
                    </div>
                    <span class="text-xl sm:text-2xl font-black bg-gradient-to-r from-gray-900 via-primary-600 to-secondary-600 bg-clip-text text-transparent group-hover:opacity-90 transition-opacity tracking-tight">
                        {SITE_CONFIG?.name || 'TuTienda'}
                    </span>
                </a>
            </div>

            <!-- NAVEGACIÓN EN ESCRITORIO CON LÍNEA ANIMADA -->
            <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
                {[
                    { name: 'Inicio', url: '/' },
                    { name: 'Productos', url: '/productos' },
                    { name: 'Artículos', url: '/articulos' },
                    { name: 'Contacto', url: '#contacto' },
                ].map(link => (
                    <a 
                        href={link.url} 
                        class="relative px-3.5 py-2 text-sm font-semibold text-gray-700 hover:text-primary-600 transition-colors duration-200 group rounded-xl hover:bg-primary-50/50"
                    >
                        <span>{link.name}</span>
                        <span class="absolute bottom-1 left-3.5 right-3.5 h-0.5 bg-primary-600 rounded-full scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-out origin-left"></span>
                    </a>
                ))}
            </nav>

            <!-- BÚSQUEDA Y MENÚ MÓVIL -->
            <div class="flex items-center space-x-3">
                <!-- Search Box en Escritorio -->
                <div class="hidden sm:block">
                    <SearchBox client:load />
                </div>

                <!-- Botón Menú Móvil con Rotación de Ícono -->
                <button 
                    id="mobile-menu-btn"
                    type="button"
                    class="md:hidden w-10 h-10 flex items-center justify-center rounded-xl text-gray-700 hover:text-primary-600 bg-gray-100/80 hover:bg-gray-100 transition-all duration-200 focus:outline-none active:scale-95"
                    aria-label="Abrir menú de navegación"
                >
                    <i id="menu-icon" class="fas fa-bars text-lg transition-transform duration-300"></i>
                </button>
            </div>
        </div>

        <!-- Búsqueda Integrada en Móvil -->
        <div class="sm:hidden pb-3 pt-1">
            <SearchBox client:load />
        </div>
    </div>

    <!-- MENÚ MÓVIL DESPLEGABLE CON ANIMACIÓN -->
    <div 
        id="mobile-menu" 
        class="hidden md:hidden border-t border-gray-100 bg-white/95 backdrop-blur-xl px-4 pt-3 pb-5 space-y-1.5 shadow-xl transition-all duration-300"
    >
        <a href="/" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-bold text-gray-800 hover:text-primary-600 hover:bg-primary-50/80 transition-all active:scale-98">
            <i class="fas fa-home text-xs text-primary-500"></i>
            <span>Inicio</span>
        </a>
        <a href="/productos" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-bold text-gray-800 hover:text-primary-600 hover:bg-primary-50/80 transition-all active:scale-98">
            <i class="fas fa-box-open text-xs text-primary-500"></i>
            <span>Productos</span>
        </a>
        <a href="/articulos" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-bold text-gray-800 hover:text-primary-600 hover:bg-primary-50/80 transition-all active:scale-98">
            <i class="fas fa-newspaper text-xs text-primary-500"></i>
            <span>Artículos</span>
        </a>
        <a href="#contacto" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-bold text-gray-800 hover:text-primary-600 hover:bg-primary-50/80 transition-all active:scale-98">
            <i class="fas fa-envelope text-xs text-primary-500"></i>
            <span>Contacto</span>
        </a>
    </div>
</header>

<!-- SCRIPT DE INTERACTIVIDAD PARA MÓVIL -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');

        if (!menuBtn || !mobileMenu || !menuIcon) return;

        menuBtn.addEventListener('click', () => {
            const isOpen = !mobileMenu.classList.contains('hidden');

            if (isOpen) {
                // Cerrar menú
                mobileMenu.classList.add('hidden');
                menuIcon.className = 'fas fa-bars text-lg transition-transform duration-300 rotate-0';
            } else {
                // Abrir menú
                mobileMenu.classList.remove('hidden');
                menuIcon.className = 'fas fa-times text-lg transition-transform duration-300 rotate-90';
            }
        });

        // Cerrar menú al hacer clic en cualquier enlace
        const mobileLinks = mobileMenu.querySelectorAll('a');
        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                menuIcon.className = 'fas fa-bars text-lg transition-transform duration-300 rotate-0';
            });
        });
    });
</script>