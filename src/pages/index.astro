---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ArticlesSection from '../components/ArticlesSection.astro';
import Footer from '../components/islands/Footer.jsx';
import { SITE_CONFIG, SEO_DEFAULTS } from '../utils/constants.js';
---

<Layout 
    title={SITE_CONFIG.title}
    description={SITE_CONFIG.description}
    keywords={SEO_DEFAULTS.keywords}
    ogImage={SEO_DEFAULTS.ogImage}
    ogType="website"
    canonicalURL={SITE_CONFIG.url}
    author={SITE_CONFIG.author}
>
    <Header />
    <main id="main-content">
        <HeroSection />
        <ProductsSection />
        <ArticlesSection />
    </main>
    <Footer client:load />
</Layout>