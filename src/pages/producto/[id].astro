---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/islands/Footer.jsx';
import ProductCard from '../../components/ProductCard.jsx';
import { generateProductSchema } from '../../utils/seo.js';
import { SITE_CONFIG, SEO_DEFAULTS } from '../../utils/constants.js';
import productsData from '../../data/products.json';

// --- GENERACIÓN DE RUTAS ESTÁTICAS (SSG) ---
export async function getStaticPaths() {
    return productsData.map(product => ({
        params: { id: String(product.id) },
        props: { product }
    }));
}

const { product } = Astro.props;

// Normalización e inspección defensiva de imágenes
const images = Array.isArray(product.IMG) && product.IMG.length > 0 
    ? product.IMG 
    : ['https://via.placeholder.com/600x600?text=Sin+Imagen'];

// Productos relacionados de la misma categoría
const relatedProducts = productsData
    .filter(p => p.CATEGORIA === product.CATEGORIA && String(p.id) !== String(product.id))
    .slice(0, 4);

// Construcción del Breadcrumb
const breadcrumbItems = [
    { name: 'Inicio', url: '/' },
    { name: 'Productos', url: '/productos' },
    { name: product.CATEGORIA, url: `/productos?categoria=${encodeURIComponent(product.CATEGORIA)}` },
    { name: product.TITULO, url: `/producto/${product.id}` }
];

// Generación de Datos Estructurados para SEO
const productSchema = generateProductSchema(product);

// URLs de interacción social y contacto
const whatsappMessage = encodeURIComponent(`Hola ${SITE_CONFIG.name}, estoy interesado en comprar el producto: ${product.TITULO} (ID: ${product.id}). ¿Tienen disponibilidad?`);
const whatsappUrl = `https://wa.me/${SITE_CONFIG.whatsapp}?text=${whatsappMessage}`;
const cleanPhone = SITE_CONFIG.phone.replace(/\s+/g, '');
const canonicalURL = `${SITE_CONFIG.siteUrl}/producto/${product.id}`;
const facebookShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalURL)}`;
---

<Layout 
    title={`${product.TITULO} | ${SITE_CONFIG.name}`}
    description={`${product.DESCRIPCION} Precio: $${product.PRECIO}. Envío gratis y garantía asegurada en ${SITE_CONFIG.name}.`}
    keywords={`${product.TITULO}, ${product.CATEGORIA}, $${product.PRECIO}, ${SEO_DEFAULTS.keywords}`}
    ogImage={images[0]}
    ogType="product"
    canonicalURL={canonicalURL}
    structuredData={productSchema}
>
    <Header />
    
    <!-- Contenedor principal con pb-28 en móvil para dar espacio a la barra flotante -->
    <main class="bg-gray-50/50 min-h-screen pb-28 lg:pb-16 animate-fade-in-up">
        
        <!-- BREADCRUMB -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 overflow-x-auto scrollbar-none">
            <Breadcrumb items={breadcrumbItems} />
        </div>

        <!-- SECCIÓN PRINCIPAL DEL PRODUCTO -->
        <section class="py-4 sm:py-8">
            <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
                
                <div class="bg-white rounded-2xl sm:rounded-3xl border border-gray-100 shadow-sm p-4 sm:p-8 lg:p-10 grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-start">
                    
                    <!-- COLUMNA IZQUIERDA: GALERÍA DE IMÁGENES -->
                    <div class="space-y-3 lg:sticky lg:top-24">
                        
                        <!-- Imagen Principal -->
                        <div class="relative aspect-square w-full rounded-2xl overflow-hidden bg-gray-100 border border-gray-100 shadow-xs group">
                            <img
                                id="mainImage"
                                src={images[0]}
                                alt={product.TITULO}
                                class="w-full h-full object-cover transition-all duration-300 ease-out group-hover:scale-105"
                            />
                            
                            <!-- Insignia de Categoría -->
                            <div class="absolute top-3 left-3">
                                <span class="backdrop-blur-md bg-white/90 text-gray-800 text-[11px] sm:text-xs font-bold px-3 py-1.5 rounded-full shadow-xs border border-white/50 tracking-wide uppercase">
                                    {product.CATEGORIA}
                                </span>
                            </div>
                        </div>
                        
                        <!-- Miniaturas de la Galería (Horizontal Tactil en Móvil) -->
                        {images.length > 1 && (
                            <div class="flex sm:grid sm:grid-cols-4 gap-2.5 overflow-x-auto pb-2 sm:pb-0 snap-x scrollbar-none">
                                {images.map((img, index) => (
                                    <button
                                        type="button"
                                        class={`thumbnail-button shrink-0 w-20 h-20 sm:w-auto sm:h-auto relative aspect-square rounded-xl overflow-hidden border-2 transition-all duration-200 snap-start focus:outline-none ${index === 0 ? 'border-primary-500 ring-2 ring-primary-500/30' : 'border-gray-200 hover:border-gray-300 active:scale-95'}`}
                                        data-img-src={img}
                                        aria-label={`Ver imagen ${index + 1}`}
                                    >
                                        <img
                                            src={img}
                                            alt={`${product.TITULO} - Vista ${index + 1}`}
                                            class="w-full h-full object-cover pointer-events-none"
                                            loading="lazy"
                                        />
                                    </button>
                                ))}
                            </div>
                        )}
                    </div>

                    <!-- COLUMNA DERECHA: INFORMACIÓN Y CONVERSIÓN -->
                    <div class="flex flex-col justify-between space-y-6">
                        
                        <div>
                            <!-- Stock Indicator -->
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold mb-3">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                En Stock - Entrega Inmediata
                            </div>

                            <!-- Título del Producto -->
                            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-gray-900 tracking-tight leading-snug mb-3">
                                {product.TITULO}
                            </h1>

                            <!-- Rating & Reviews -->
                            <div class="flex items-center space-x-2.5 mb-5">
                                <div class="flex items-center text-amber-400 text-xs sm:text-sm">
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star"></i>
                                    <i class="fas fa-star-half-alt"></i>
                                </div>
                                <span class="text-xs text-gray-500 font-medium">(4.8 / 5.0)</span>
                            </div>

                            <!-- Tarjeta de Precio -->
                            <div class="p-4 sm:p-5 bg-gradient-to-br from-gray-50 to-white rounded-2xl border border-gray-100 mb-6 flex items-center justify-between shadow-xs">
                                <div>
                                    <span class="text-[10px] sm:text-xs text-gray-400 block font-bold uppercase tracking-wider">Precio Garantizado</span>
                                    <span class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight">
                                        ${product.PRECIO}
                                    </span>
                                </div>
                                <span class="text-xs text-emerald-700 font-semibold bg-emerald-100/70 px-3 py-1.5 rounded-xl border border-emerald-200/50">
                                    <i class="fas fa-truck text-xs mr-1"></i> Envío Exprés
                                </span>
                            </div>

                            <!-- Descripción -->
                            <div class="mb-6">
                                <h2 class="text-xs font-bold text-gray-900 uppercase tracking-wider mb-2">Descripción del Producto</h2>
                                <p class="text-gray-600 leading-relaxed text-sm sm:text-base">
                                    {product.DESCRIPCION}
                                </p>
                            </div>

                            <!-- Tarjetas de Beneficios (Grid 2x2) -->
                            <div class="grid grid-cols-2 gap-2.5 sm:gap-3 mb-6">
                                <div class="flex items-center space-x-3 p-3 bg-white border border-gray-100 rounded-xl shadow-2xs">
                                    <div class="w-9 h-9 rounded-lg bg-primary-50 text-primary-600 flex items-center justify-center shrink-0">
                                        <i class="fas fa-shipping-fast text-sm"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-xs font-bold text-gray-800 truncate">Envío Gratis</p>
                                        <p class="text-[10px] text-gray-500 truncate">A todo el país</p>
                                    </div>
                                </div>

                                <div class="flex items-center space-x-3 p-3 bg-white border border-gray-100 rounded-xl shadow-2xs">
                                    <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                                        <i class="fas fa-shield-alt text-sm"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-xs font-bold text-gray-800 truncate">Garantía Directa</p>
                                        <p class="text-[10px] text-gray-500 truncate">100% Seguro</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ACCIONES DE COMPRA Y CONTACTO -->
                        <div class="space-y-3 pt-4 border-t border-gray-100">
                            
                            <!-- WhatsApp CTA Principal -->
                            <a 
                                href={whatsappUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="w-full bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 text-white min-h-[48px] py-3.5 px-6 rounded-2xl font-bold text-sm sm:text-base transition-all duration-200 active:scale-98 shadow-md hover:shadow-xl flex items-center justify-center space-x-2 group"
                            >
                                <i class="fab fa-whatsapp text-xl group-hover:scale-110 transition-transform"></i>
                                <span>Me interesa comprar este producto</span>
                            </a>

                            <!-- Botones Secundarios (Compartir y Llamada) -->
                            <div class="grid grid-cols-2 gap-2.5">
                                <a 
                                    href={facebookShareUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="bg-blue-50 hover:bg-blue-100 text-blue-700 min-h-[44px] py-2.5 px-3 rounded-xl font-semibold text-xs sm:text-sm transition-colors flex items-center justify-center space-x-2 border border-blue-100"
                                >
                                    <i class="fab fa-facebook-f text-xs"></i>
                                    <span>Compartir</span>
                                </a>

                                <a 
                                    href={`tel:${cleanPhone}`}
                                    class="bg-gray-100 hover:bg-gray-200 text-gray-700 min-h-[44px] py-2.5 px-3 rounded-xl font-semibold text-xs sm:text-sm transition-colors flex items-center justify-center space-x-2 border border-gray-200"
                                >
                                    <i class="fas fa-phone text-xs"></i>
                                    <span>Llamar ahora</span>
                                </a>
                            </div>

                        </div>

                        <!-- Ficha Técnica Resumida -->
                        <div class="border-t border-gray-100 pt-3 text-[11px] sm:text-xs text-gray-500 grid grid-cols-2 gap-2">
                            <p><span class="font-semibold text-gray-700">SKU / ID:</span> #{product.id}</p>
                            <p><span class="font-semibold text-gray-700">Categoría:</span> {product.CATEGORIA}</p>
                        </div>

                    </div>

                </div>

            </div>
        </section>

        <!-- SECCIÓN PRODUCTOS RELACIONADOS -->
        {relatedProducts.length > 0 && (
            <section class="py-8 sm:py-12 border-t border-gray-200/60 mt-8">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 tracking-tight">
                                Productos Relacionados
                            </h2>
                            <p class="text-xs sm:text-sm text-gray-500 mt-0.5">
                                Explora más opciones en <span class="font-semibold text-gray-700">{product.CATEGORIA}</span>
                            </p>
                        </div>
                        
                        <a href={`/productos?categoria=${encodeURIComponent(product.CATEGORIA)}`} class="text-xs sm:text-sm font-semibold text-primary-600 hover:text-primary-700 flex items-center gap-1">
                            Ver todos <i class="fas fa-arrow-right text-[10px]"></i>
                        </a>
                    </div>
                    
                    <!-- Grid Responsive: 2 columnas en móvil / 4 en PC -->
                    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-6">
                        {relatedProducts.map(relatedProduct => (
                            <ProductCard product={relatedProduct} />
                        ))}
                    </div>

                </div>
            </section>
        )}

    </main>

    <!-- BARRA FLOTANTE DE COMPRA INFERIOR (EXCLUSIVA MÓVIL / CELULAR) -->
    <div class="lg:hidden fixed bottom-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-t border-gray-200/80 p-3 px-4 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] flex items-center justify-between gap-3">
        <div>
            <span class="text-[10px] text-gray-400 block font-bold uppercase tracking-wider">Precio</span>
            <span class="text-2xl font-extrabold text-gray-900 tracking-tight">${product.PRECIO}</span>
        </div>

        <a 
            href={whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex-1 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white min-h-[44px] py-2.5 px-4 rounded-xl font-bold text-sm flex items-center justify-center gap-2 shadow-md transition-all"
        >
            <i class="fab fa-whatsapp text-lg"></i>
            <span>Comprar Ahora</span>
        </a>
    </div>

    <Footer client:load />
</Layout>

<!-- CLIENT SCRIPT FOR GALLERY INTERACTION -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const thumbnailButtons = document.querySelectorAll('.thumbnail-button');
        const mainImage = document.getElementById('mainImage') as HTMLImageElement;

        if (!mainImage || thumbnailButtons.length === 0) return;

        thumbnailButtons.forEach((button) => {
            button.addEventListener('click', () => {
                const newSrc = button.getAttribute('data-img-src');
                if (!newSrc || mainImage.src === newSrc) return;

                // Animación de cambio de imagen
                mainImage.style.opacity = '0.4';

                setTimeout(() => {
                    mainImage.src = newSrc;
                    mainImage.style.opacity = '1';
                }, 120);

                // Actualización de borde activo
                thumbnailButtons.forEach((btn) => {
                    btn.classList.remove('border-primary-500', 'ring-2', 'ring-primary-500/30');
                    btn.classList.add('border-gray-200');
                });

                button.classList.remove('border-gray-200');
                button.classList.add('border-primary-500', 'ring-2', 'ring-primary-500/30');
            });
        });
    });
</script>

<!-- STYLES & ANIMATIONS -->
<style>
    .scrollbar-none::-webkit-scrollbar { display: none; }
    .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.4s ease-out forwards;
    }
</style>