---
import SnakeGame from "../components/SnakeGame.tsx";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Snake Game</title>

  <style>
    .snake-game {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      width: 100%;
      padding: 20px;
      box-sizing: border-box;
      font-family: system-ui, sans-serif;
    }

    .game-header {
      display: flex;
      gap: 1rem;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      width: 100%;
    }

    .game-header > div {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }

    .snake-board {
      position: relative;
      display: grid;
      width: min(90vw, 500px);
      aspect-ratio: 1;
      background: #111827;
      border: 3px solid #374151;
      border-radius: 12px;
      overflow: hidden;
      touch-action: none;
    }

    .cell {
      min-width: 0;
      min-height: 0;
      border: 1px solid rgba(255, 255, 255, 0.02);
    }

    .cell.snake {
      background: #22c55e;
    }

    .cell.snake-head {
      background: #16a34a;
      border-radius: 4px;
    }

    .cell.food {
      background: #ef4444;
      border-radius: 50%;
      transform: scale(0.75);
    }

    .cell.bonus-food {
      background: #facc15;
      border-radius: 50%;
      transform: scale(0.75);
      animation: pulse 0.8s infinite alternate;
    }

    @keyframes pulse {
      from {
        transform: scale(0.7);
      }

      to {
        transform: scale(1);
      }
    }

    .game-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      color: white;
      text-align: center;
      z-index: 10;
    }

    .game-overlay h2 {
      margin: 0;
      font-size: 2rem;
    }

    .game-overlay p {
      margin: 0;
    }

    .game-controls {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      align-items: center;
      justify-content: center;
    }

    .game-controls > div {
      display: flex;
      gap: 0.5rem;
    }

    .game-controls button {
      width: 55px;
      height: 50px;
      padding: 0;
      font-size: 20px;
    }

    .game-options {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
    }

    button {
      padding: 0.6rem 1rem;
      border-radius: 0.5rem;
      border: none;
      background: #1f2937;
      color: white;
      cursor: pointer;
      font-weight: 600;
    }

    button:hover:not(:disabled) {
      background: #374151;
    }

    button:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    select {
      padding: 0.45rem;
      border-radius: 0.4rem;
      border: 1px solid #d1d5db;
    }

    @media (max-width: 600px) {
      .snake-game {
        padding: 10px;
      }

      .snake-board {
        width: min(94vw, 450px);
      }

      .game-header {
        gap: 0.5rem;
      }
    }
  </style>
</head>

<body>

  <SnakeGame client:load />

</body>
</html>