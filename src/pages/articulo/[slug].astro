---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/islands/Footer.jsx';

export async function getStaticPaths() {
	const articles = await Astro.glob('../../articles/*.md');
	
	return articles.map(article => {
		const slug = article.file.split('/').pop().replace('.md', '');
		return {
			params: { slug },
			props: { article }
		};
	});
}

const { article } = Astro.props;
const { Content, frontmatter } = article;

// Obtener artículos relacionados
const allArticles = await Astro.glob('../../articles/*.md');
const relatedArticles = allArticles
	.filter(a => a.frontmatter.category === frontmatter.category && a.file !== article.file)
	.sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date))
	.slice(0, 3);
---

<Layout 
	title={`${frontmatter.title} | TuTienda Blog`}
	description={frontmatter.excerpt}
	keywords={`${frontmatter.category}, ${frontmatter.title}, blog, artículo, guía, consejos, tendencias`}
	ogImage={frontmatter.image}
	ogType="article"
	canonicalURL={`https://tu-tienda.com/articulo/${Astro.params.slug}`}
	author="TuTienda"
	twitterCard="summary_large_image"
>
	<Header />
	<main>
		<!-- Breadcrumb -->
		<nav class="bg-gray-50 py-4">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
				<ol class="flex items-center space-x-2 text-sm">
					<li><a href="/" class="text-primary-600 hover:text-primary-700">Inicio</a></li>
					<li class="text-gray-400">/</li>
					<li><a href="/articulos" class="text-primary-600 hover:text-primary-700">Artículos</a></li>
					<li class="text-gray-400">/</li>
					<li class="text-gray-900 font-medium">{frontmatter.title}</li>
				</ol>
			</div>
		</nav>

		<!-- Article Header -->
		<header class="py-16 bg-white">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
				<!-- Category Badge -->
				<div class="mb-4">
					<span class="bg-primary-100 text-primary-600 px-3 py-1 rounded-full text-sm font-semibold">
						{frontmatter.category}
					</span>
				</div>

				<!-- Title -->
				<h1 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6 leading-tight">
					{frontmatter.title}
				</h1>

				<!-- Meta Info -->
				<div class="flex items-center space-x-6 text-gray-600 mb-8">
					<div class="flex items-center space-x-2">
						<i class="fas fa-calendar-alt"></i>
						<time datetime={frontmatter.date}>
							{new Date(frontmatter.date).toLocaleDateString('es-ES', {
								year: 'numeric',
								month: 'long',
								day: 'numeric'
							})}
						</time>
					</div>
					<div class="flex items-center space-x-2">
						<i class="fas fa-clock"></i>
						<span>5 min de lectura</span>
					</div>
				</div>

				<!-- Featured Image -->
				<div class="relative overflow-hidden rounded-2xl shadow-2xl mb-8">
					<img
						src={frontmatter.image}
						alt={frontmatter.title}
						class="w-full h-64 lg:h-96 object-cover"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
				</div>

				<!-- Social Share Buttons -->
				<div class="flex items-center space-x-4">
					<span class="text-gray-600 font-medium">Compartir:</span>
					<button 
						onclick="shareOnFacebook()"
						class="flex items-center space-x-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition-colors"
					>
						<i class="fab fa-facebook"></i>
						<span>Facebook</span>
					</button>
					<button 
						onclick={`shareOnWhatsApp('${frontmatter.title}')`}
						class="flex items-center space-x-2 bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg transition-colors"
					>
						<i class="fab fa-whatsapp"></i>
						<span>WhatsApp</span>
					</button>
					<button 
						onclick="shareGeneric()"
						class="flex items-center space-x-2 bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg transition-colors"
					>
						<i class="fas fa-share"></i>
						<span>Compartir</span>
					</button>
				</div>
			</div>
		</header>

		<!-- Article Content -->
		<article class="py-16 bg-white">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="prose prose-lg prose-primary max-w-none">
					<Content />
				</div>
				
				<!-- Article Footer -->
				<footer class="mt-16 pt-8 border-t border-gray-200">
					<div class="flex flex-col sm:flex-row justify-between items-center space-y-4 sm:space-y-0">
						<!-- Tags -->
						<div class="flex items-center space-x-2">
							<span class="text-gray-600 font-medium">Etiquetas:</span>
							<span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm">
								{frontmatter.category}
							</span>
						</div>
						
						<!-- Back to Articles -->
						<a 
							href="/articulos"
							class="flex items-center space-x-2 text-primary-600 hover:text-primary-700 font-medium transition-colors"
						>
							<i class="fas fa-arrow-left"></i>
							<span>Ver todos los artículos</span>
						</a>
					</div>
				</footer>
			</div>
		</article>

		<!-- Related Articles -->
		{relatedArticles.length > 0 && (
			<section class="py-16 bg-gray-50">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<h2 class="text-3xl font-bold text-gray-900 mb-12 text-center">
						Artículos Relacionados
					</h2>
					
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
						{relatedArticles.map(relatedArticle => (
							<article class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transform hover:scale-105 transition-all duration-300">
								<div class="relative overflow-hidden h-48">
									<img 
										src={relatedArticle.frontmatter.image} 
										alt={relatedArticle.frontmatter.title}
										class="w-full h-full object-cover hover:scale-110 transition-transform duration-500"
										loading="lazy"
									/>
									<div class="absolute top-4 left-4">
										<span class="bg-primary-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
											{relatedArticle.frontmatter.category}
										</span>
									</div>
								</div>
								
								<div class="p-6">
									<div class="flex items-center text-sm text-gray-500 mb-3">
										<i class="fas fa-calendar-alt mr-2"></i>
										{new Date(relatedArticle.frontmatter.date).toLocaleDateString('es-ES', {
											year: 'numeric',
											month: 'long',
											day: 'numeric'
										})}
									</div>
									
									<h3 class="text-xl font-bold text-gray-900 mb-3 line-clamp-2 hover:text-primary-600 transition-colors">
										<a href={`/articulo/${relatedArticle.file.split('/').pop().replace('.md', '')}`}>
											{relatedArticle.frontmatter.title}
										</a>
									</h3>
									
									<p class="text-gray-600 mb-4 line-clamp-3">
										{relatedArticle.frontmatter.excerpt}
									</p>
									
									<a 
										href={`/articulo/${relatedArticle.file.split('/').pop().replace('.md', '')}`}
										class="inline-flex items-center text-primary-600 hover:text-primary-700 font-semibold transition-colors"
									>
										Leer más
										<i class="fas fa-arrow-right ml-2"></i>
									</a>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>
		)}
	</main>
	<Footer client:load />

	<!-- Structured Data for Article -->
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Article",
		"headline": frontmatter.title,
		"description": frontmatter.excerpt,
		"image": frontmatter.image,
		"author": {
			"@type": "Organization",
			"name": "TuTienda"
		},
		"publisher": {
			"@type": "Organization",
			"name": "TuTienda",
			"logo": {
				"@type": "ImageObject",
				"url": "https://tu-tienda.com/logo.png"
			}
		},
		"datePublished": frontmatter.date,
		"dateModified": frontmatter.date
	})} />
</Layout>

<script>
	window.shareOnFacebook = function() {
		const url = encodeURIComponent(window.location.href);
		window.open('https://www.facebook.com/sharer/sharer.php?u=' + url, '_blank');
	};

	window.shareOnWhatsApp = function(title) {
		const text = encodeURIComponent(title + ' - ' + window.location.href);
		window.open('https://wa.me/?text=' + text, '_blank');
	};

	window.shareGeneric = function() {
		if (navigator.share) {
			navigator.share({
				title: document.title,
				url: window.location.href
			});
		} else {
			navigator.clipboard.writeText(window.location.href);
		}
	};
</script>

<style>
	/* Prose Styling for Article Content */
	.prose {
		color: #374151;
		max-width: none;
	}
	
	.prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
		color: #111827;
		font-weight: 700;
		line-height: 1.25;
		margin-top: 2rem;
		margin-bottom: 1rem;
	}
	
	.prose h2 {
		font-size: 1.875rem;
		border-bottom: 2px solid #e5e7eb;
		padding-bottom: 0.5rem;
	}
	
	.prose h3 {
		font-size: 1.5rem;
		color: #3b82f6;
	}
	
	.prose p {
		margin-bottom: 1.25rem;
		line-height: 1.75;
	}
	
	.prose ul, .prose ol {
		margin-bottom: 1.25rem;
		padding-left: 1.5rem;
	}
	
	.prose li {
		margin-bottom: 0.5rem;
	}
	
	.prose strong {
		font-weight: 600;
		color: #111827;
	}
	
	.prose em {
		font-style: italic;
		color: #6b7280;
	}
	
	.prose blockquote {
		border-left: 4px solid #3b82f6;
		padding-left: 1rem;
		margin: 2rem 0;
		font-style: italic;
		color: #6b7280;
		background: #f8fafc;
		padding: 1rem 1rem 1rem 2rem;
		border-radius: 0 0.5rem 0.5rem 0;
	}
	
	.prose code {
		background: #f1f5f9;
		color: #e11d48;
		padding: 0.125rem 0.375rem;
		border-radius: 0.375rem;
		font-size: 0.875rem;
		font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono', monospace;
	}
	
	.prose table {
		width: 100%;
		border-collapse: collapse;
		margin: 2rem 0;
	}
	
	.prose th, .prose td {
		border: 1px solid #e5e7eb;
		padding: 0.75rem;
		text-align: left;
	}
	
	.prose th {
		background: #f9fafb;
		font-weight: 600;
	}
</style>