---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/islands/Footer.jsx';
import ArticleGallery from '../../components/articles/ArticleGallery.tsx';
import ArticleNewsletter from '../../components/articles/ArticleNewsletter.tsx';
import { SITE_CONFIG, SEO_DEFAULTS } from '../../utils/constants.js';

// Carga estática de todos los artículos de Markdown mediante la API de Vite
const articleImports = import.meta.glob('../../articles/*.md', { eager: true });
const rawArticles = Object.values(articleImports);

// Normalización de artículos con slugs y metadatos seguros
const articles = rawArticles.map((article: any) => {
    const filename = article.file ? article.file.split('/').pop().replace('.md', '') : '';
    return {
        id: filename,
        slug: filename,
        title: article.frontmatter?.title || 'Artículo sin título',
        date: article.frontmatter?.date || new Date().toISOString(),
        category: article.frontmatter?.category || 'General',
        image: article.frontmatter?.image || 'https://images.pexels.com/photos/8566473/pexels-photo-8566473.jpeg',
        excerpt: article.frontmatter?.excerpt || '',
        author: article.frontmatter?.author || SITE_CONFIG.name,
        readTime: article.frontmatter?.readTime || '5 min',
        featured: Boolean(article.frontmatter?.featured)
    };
});

// Ordenar inicialmente por fecha más reciente
const sortedArticles = articles.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Obtener lista única de categorías ordenadas
const categories = [...new Set(sortedArticles.map(a => a.category).filter(Boolean))].sort();

// Datos Estructurados Schema.org para el Blog
const blogSchema = {
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": `Blog & Guías Técnicas | ${SITE_CONFIG.name}`,
    "description": "Artículos, consejos y guías especializadas en mantenimiento de computadoras, reparación de celulares, software y publicidad.",
    "url": `${SITE_CONFIG.siteUrl}/articulos`,
    "publisher": {
        "@type": "Organization",
        "name": SITE_CONFIG.name,
        "logo": {
            "@type": "ImageObject",
            "url": `${SITE_CONFIG.siteUrl}/favicon.svg`
        }
    },
    "blogPost": sortedArticles.map(art => ({
        "@type": "BlogPosting",
        "headline": art.title,
        "description": art.excerpt,
        "image": art.image,
        "datePublished": art.date,
        "url": `${SITE_CONFIG.siteUrl}/articulo/${art.slug}`
    }))
};
---

<Layout 
    title={`Artículos, Guías y Consejos | ${SITE_CONFIG.name}`}
    description={`Descubre guías prácticas sobre reparación de celulares, mantenimiento de computadoras, optimización de software y publicidad en ${SITE_CONFIG.name}.`}
    keywords={`blog tecnologia, mantenimiento computadoras, reparacion celulares, tutoriales tech, software pc, publicidad, ${SEO_DEFAULTS.keywords}`}
    ogImage={sortedArticles[0]?.image || SEO_DEFAULTS.ogImage}
    ogType="blog"
    canonicalURL={`${SITE_CONFIG.siteUrl}/articulos`}
>
    <Header />

    <main class="bg-gray-50/60 min-h-screen pb-20">
        
        {/* --- HERO HEADER CON PATTERN Y BRANDING --- */}
        <section class="relative overflow-hidden bg-gradient-to-b from-primary-50/80 via-white to-gray-50/50 py-16 sm:py-20 border-b border-gray-100">
            {/* Pattern de puntos */}
            <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:18px_18px] opacity-60 pointer-events-none"></div>

            {/* Luces difusas de ambiente */}
            <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[500px] h-[250px] bg-gradient-to-tr from-primary-400/20 via-secondary-400/20 to-emerald-400/15 blur-3xl rounded-full pointer-events-none"></div>

            <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center animate-fade-in-up">
                {/* Badge Superior */}
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/90 backdrop-blur-md border border-primary-200/60 shadow-xs text-xs font-semibold text-gray-800 mb-5">
                    <span class="flex h-2 w-2 relative">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary-600"></span>
                    </span>
                    <span class="bg-gradient-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent font-black tracking-wide uppercase">
                        Blog & Guías Técnicas
                    </span>
                    <span class="text-gray-300">•</span>
                    <span class="text-gray-500 font-medium">{sortedArticles.length} Artículos Disponibles</span>
                </div>

                {/* Título Principal */}
                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-gray-900 tracking-tight mb-4 leading-tight">
                    Aprende, Optimiza y <span class="bg-gradient-to-r from-primary-600 via-secondary-500 to-primary-600 bg-clip-text text-transparent">Potencia tu Tecnología</span>
                </h1>

                {/* Subtítulo */}
                <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto font-normal leading-relaxed">
                    Consejos de expertos, tutoriales de mantenimiento y guías esenciales para cuidar tus dispositivos y hacer crecer tu negocio con FixStore.
                </p>
            </div>
        </section>

        {/* --- CONTENIDO PRINCIPAL: GALERÍA INTERACTIVA (ISLA REACT TSX) --- */}
        <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-16">
            <ArticleGallery 
                client:load 
                initialArticles={sortedArticles} 
                categories={categories} 
            />

            {/* --- SECCIÓN BOLETÍN / NEWSLETTER --- */}
            <ArticleNewsletter client:load />
        </section>

    </main>

    <Footer client:load />

    <!-- Schema.org Microdata -->
    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
</Layout>